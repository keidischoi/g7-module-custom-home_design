{
  "version": "1.0.0",
  "meta": {
    "title": "$t:custom-home_design.admin.settings.title",
    "description": "$t:custom-home_design.admin.settings.description"
  },
  "layout_name": "admin_home_design_settings",
  "permissions": [
    "custom-home_design.design.read",
    "custom-home_design.design.update"
  ],
  "extends": "_admin_base",
  "data_sources": [
    {
      "id": "settings",
      "type": "api",
      "endpoint": "/api/modules/custom-home_design/admin/settings",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "initLocal": "form",
      "refetchOnMount": true,
      "fallback": {
        "data": {
          "content_max_width_px": 1240,
          "hide_desktop_top_nav": false,
          "header_search_icon_mode": true,
          "header_theme_click_toggle": true,
          "hide_header_board_slugs": [],
          "footer_link_groups_json": "",
          "footer_link_groups": null,
          "business_info_enabled": false,
          "enabled": true,
          "hide_header_board_slugs_text": ""
        }
      }
    },
    {
      "id": "boards",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/board-menu",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "refetchOnMount": true,
      "fallback": {
        "data": [
          {
            "slug": "notice",
            "name": "공지"
          },
          {
            "slug": "free",
            "name": "자유게시판"
          },
          {
            "slug": "gallery",
            "name": "갤러리"
          },
          {
            "slug": "qna",
            "name": "Q&A"
          },
          {
            "slug": "inquiry",
            "name": "문의"
          }
        ]
      }
    }
  ],
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "local",
        "errors": null,
        "saving": false
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "chd_settings_wrapper",
        "type": "basic",
        "name": "Div",
        "dataKey": "form",
        "trackChanges": true,
        "props": {
          "className": "admin-page-content w-full max-w-none"
        },
        "children": [
          {
            "id": "chd_settings_header",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "flex-between mb-6"
            },
            "children": [
              {
                "type": "basic",
                "name": "H1",
                "props": {
                  "className": "text-page-heading"
                },
                "text": "$t:custom-home_design.admin.settings.title"
              }
            ]
          },
          {
            "id": "error_message_box",
            "type": "basic",
            "name": "Div",
            "if": "{{_local.errors && Object.keys(_local.errors).length > 0}}",
            "props": {
              "className": "alert-danger mb-6"
            },
            "children": [
              {
                "type": "basic",
                "name": "P",
                "text": "$t:custom-home_design.admin.settings.validation_error"
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-8 p-4 border border-gray-200 dark:border-gray-700 rounded-lg"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "props": {
                  "className": "text-lg font-semibold mb-4"
                },
                "text": "$t:custom-home_design.admin.settings.sections.general"
              },
              {
                "id": "field_width",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "form-group w-full"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "className": "form-label"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "$t:custom-home_design.admin.settings.fields.content_max_width_px"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Input",
                    "props": {
                      "type": "number",
                      "name": "content_max_width_px",
                      "className": "input w-full",
                      "placeholder": "1240",
                      "min": 320,
                      "max": 2560,
                      "value": "{{_local.form?.content_max_width_px ?? 1240}}",
                      "autoBinding": false
                    },
                    "actions": [
                      {
                        "type": "change",
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "form.content_max_width_px": "{{Number($event.target.value) || 1240}}"
                        }
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-xs text-gray-500 mt-1"
                    },
                    "text": "$t:custom-home_design.admin.settings.fields.content_max_width_px_hint"
                  }
                ]
              },
              {
                "id": "field_hide_nav",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "form-group w-full"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "className": "flex items-center gap-2 cursor-pointer"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Checkbox",
                        "props": {
                          "name": "hide_desktop_top_nav",
                          "autoBinding": false,
                          "checked": "{{_local.form?.hide_desktop_top_nav === true || _local.form?.hide_desktop_top_nav === 1 || _local.form?.hide_desktop_top_nav === '1' || _local.form?.hide_desktop_top_nav === 'true'}}"
                        },
                        "actions": [
                          {
                            "type": "change",
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "form.hide_desktop_top_nav": "{{$event.target.checked === true}}"
                            }
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm"
                        },
                        "text": "$t:custom-home_design.admin.settings.fields.hide_desktop_top_nav"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-xs text-gray-500 mt-1"
                    },
                    "text": "$t:custom-home_design.admin.settings.fields.hide_desktop_top_nav_hint"
                  }
                ]
              },
              {
                "id": "field_header_search_icon",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "form-group w-full"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "className": "flex items-center gap-2 cursor-pointer"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Checkbox",
                        "props": {
                          "name": "header_search_icon_mode",
                          "autoBinding": false,
                          "checked": "{{(_local.form?.header_search_icon_mode === undefined || _local.form?.header_search_icon_mode === null) ? true : (_local.form?.header_search_icon_mode === true || _local.form?.header_search_icon_mode === 1 || _local.form?.header_search_icon_mode === '1' || _local.form?.header_search_icon_mode === 'true')}}"
                        },
                        "actions": [
                          {
                            "type": "change",
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "form.header_search_icon_mode": "{{$event.target.checked === true}}"
                            }
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm"
                        },
                        "text": "$t:custom-home_design.admin.settings.fields.header_search_icon_mode"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-xs text-gray-500 mt-1"
                    },
                    "text": "$t:custom-home_design.admin.settings.fields.header_search_icon_mode_hint"
                  }
                ]
              },
              {
                "id": "field_header_theme_click",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "form-group w-full"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "className": "flex items-center gap-2 cursor-pointer"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Checkbox",
                        "props": {
                          "name": "header_theme_click_toggle",
                          "autoBinding": false,
                          "checked": "{{(_local.form?.header_theme_click_toggle === undefined || _local.form?.header_theme_click_toggle === null) ? true : (_local.form?.header_theme_click_toggle === true || _local.form?.header_theme_click_toggle === 1 || _local.form?.header_theme_click_toggle === '1' || _local.form?.header_theme_click_toggle === 'true')}}"
                        },
                        "actions": [
                          {
                            "type": "change",
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "form.header_theme_click_toggle": "{{$event.target.checked === true}}"
                            }
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm"
                        },
                        "text": "$t:custom-home_design.admin.settings.fields.header_theme_click_toggle"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-xs text-gray-500 mt-1"
                    },
                    "text": "$t:custom-home_design.admin.settings.fields.header_theme_click_toggle_hint"
                  }
                ]
              },
              {
                "id": "field_slugs",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "form-group w-full"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "className": "form-label"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "$t:custom-home_design.admin.settings.fields.hide_header_board_slugs"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-xs text-gray-500 mb-2"
                    },
                    "text": "$t:custom-home_design.admin.settings.fields.hide_header_board_slugs_hint"
                  },
                  {
                    "id": "field_slugs_checkbox_list",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex flex-col gap-2 p-3 rounded-md border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/40 max-h-64 overflow-y-auto"
                    },
                    "iteration": {
                      "source": "{{(() => { const d = boards?.data; if (Array.isArray(d)) return d; if (Array.isArray(d?.data)) return d.data; return []; })()}}",
                      "item_var": "board"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": {
                          "className": "flex items-center gap-2 cursor-pointer select-none"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Checkbox",
                            "props": {
                              "name": "hide_board_{{board.slug || board.bo_table}}",
                              "autoBinding": false,
                              "checked": "{{(() => { const s = String(board?.slug || board?.bo_table || '').trim(); if (!s) return false; const arr = Array.isArray(_local.form?.hide_header_board_slugs) ? _local.form.hide_header_board_slugs : []; return arr.includes(s); })()}}"
                            },
                            "actions": [
                              {
                                "type": "change",
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "form.hide_header_board_slugs": "{{(() => { const s = String(board?.slug || board?.bo_table || '').trim(); let arr = Array.isArray(_local.form?.hide_header_board_slugs) ? [..._local.form.hide_header_board_slugs] : []; if (!s) return arr; if ($event.target.checked) { if (!arr.includes(s)) arr = [...arr, s]; } else { arr = arr.filter(x => x !== s); } return arr; })()}}",
                                  "form.hide_header_board_slugs_text": "{{(() => { const s = String(board?.slug || board?.bo_table || '').trim(); let arr = Array.isArray(_local.form?.hide_header_board_slugs) ? [..._local.form.hide_header_board_slugs] : []; if (!s) return arr.join(', '); if ($event.target.checked) { if (!arr.includes(s)) arr = [...arr, s]; } else { arr = arr.filter(x => x !== s); } return arr.join(', '); })()}}"
                                }
                              }
                            ]
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "text-sm"
                            },
                            "text": "{{(board?.name || board?.bo_subject || board?.slug || board?.bo_table || '') + ' (' + (board?.slug || board?.bo_table || '') + ')'}}"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "if": "{{(() => { const d = boards?.data; const list = Array.isArray(d) ? d : (Array.isArray(d?.data) ? d.data : []); return !list.length; })()}}",
                    "props": {
                      "className": "text-xs text-amber-600 dark:text-amber-400 mt-2"
                    },
                    "text": "$t:custom-home_design.admin.settings.fields.hide_header_board_slugs_empty"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-xs text-gray-500 mt-2"
                    },
                    "text": "$t:custom-home_design.admin.settings.fields.hide_header_board_slugs_note"
                  },
                  {
                    "comment": "Hidden sync field — keeps comma text in sync for older save paths / API clients",
                    "type": "basic",
                    "name": "Input",
                    "props": {
                      "type": "hidden",
                      "name": "hide_header_board_slugs_text",
                      "value": "{{Array.isArray(_local.form?.hide_header_board_slugs) ? _local.form.hide_header_board_slugs.join(', ') : (_local.form?.hide_header_board_slugs_text ?? '')}}",
                      "autoBinding": false
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-8 p-4 border border-gray-200 dark:border-gray-700 rounded-lg"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "props": {
                  "className": "text-lg font-semibold mb-4"
                },
                "text": "$t:custom-home_design.admin.settings.sections.footer"
              },
              {
                "id": "field_link_groups",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "form-group w-full"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "className": "form-label"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "$t:custom-home_design.admin.settings.fields.footer_link_groups_json"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Textarea",
                    "props": {
                      "name": "footer_link_groups_json",
                      "className": "input w-full font-mono text-sm min-h-[18rem] h-72 resize-y",
                      "rows": 18,
                      "placeholder": "",
                      "value": "{{_local.form?.footer_link_groups_json ?? ''}}",
                      "autoBinding": false,
                      "style": {
                        "minHeight": "18rem",
                        "height": "18rem"
                      }
                    },
                    "actions": [
                      {
                        "type": "change",
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "form.footer_link_groups_json": "{{$event.target.value}}"
                        }
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-xs text-gray-500 mt-1"
                    },
                    "text": "$t:custom-home_design.admin.settings.fields.footer_link_groups_json_hint"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-xs font-semibold text-gray-600 dark:text-gray-300 mt-2"
                    },
                    "text": "$t:custom-home_design.admin.settings.fields.footer_link_groups_json_example_label"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "mt-1 p-3 rounded-md bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 text-xs font-mono whitespace-pre-wrap break-all text-gray-700 dark:text-gray-300"
                    },
                    "text": "[\n  {\n    \"title\": \"커뮤니티\",\n    \"links\": [\n      {\"label\": \"홈\", \"href\": \"/\", \"icon\": \"home\"},\n      {\"label\": \"인기\", \"href\": \"/boards/popular\", \"icon\": \"flame\"},\n      {\"label\": \"전체 게시판\", \"href\": \"/boards\", \"icon\": \"layout\"}\n    ]\n  },\n  {\n    \"title\": \"안내\",\n    \"links\": [\n      {\"label\": \"소개\", \"href\": \"/page/about\", \"icon\": \"building\"},\n      {\"label\": \"FAQ\", \"href\": \"/faq\", \"icon\": \"help\"},\n      {\"label\": \"문의\", \"href\": \"/board/inquiry\", \"icon\": \"message\"}\n    ]\n  },\n  {\n    \"title\": \"정책\",\n    \"links\": [\n      {\"label\": \"이용약관\", \"href\": \"/page/terms\", \"icon\": \"file\"},\n      {\"label\": \"개인정보처리방침\", \"href\": \"/page/privacy\", \"icon\": \"shield\"},\n      {\"label\": \"환불정책\", \"href\": \"/page/refund\", \"icon\": \"refresh\"}\n    ]\n  }\n]"
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-8 p-4 border border-gray-200 dark:border-gray-700 rounded-lg"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "props": {
                  "className": "text-lg font-semibold mb-4"
                },
                "text": "$t:custom-home_design.admin.settings.sections.business"
              },
              {
                "id": "field_bi_enabled",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "form-group w-full"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "className": "flex items-center gap-2 cursor-pointer"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Checkbox",
                        "props": {
                          "name": "business_info_enabled",
                          "autoBinding": false,
                          "checked": "{{_local.form?.business_info_enabled === true || _local.form?.business_info_enabled === 1 || _local.form?.business_info_enabled === '1' || _local.form?.business_info_enabled === 'true'}}"
                        },
                        "actions": [
                          {
                            "type": "change",
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "form.business_info_enabled": "{{$event.target.checked === true}}"
                            }
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm"
                        },
                        "text": "$t:custom-home_design.admin.settings.fields.business_info_enabled"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-xs text-gray-500 mt-1"
                    },
                    "text": "$t:custom-home_design.admin.settings.fields.business_info_enabled_hint"
                  }
                ]
              }
            ]
          },
          {
            "id": "chd_settings_footer",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "flex justify-end gap-2 mt-6"
            },
            "children": [
              {
                "id": "footer_save_button",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "disabled": "{{_local.saving}}",
                  "className": "btn btn-primary flex-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed"
                },
                "text": "$t:custom-home_design.admin.settings.save",
                "actions": [
                  {
                    "type": "click",
                    "handler": "sequence",
                    "actions": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "saving": true,
                          "errors": null
                        }
                      },
                      {
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-home_design/admin/settings",
                        "params": {
                          "method": "PUT",
                          "body": {
                            "content_max_width_px": "{{Number(_local.form?.content_max_width_px) > 0 ? Number(_local.form.content_max_width_px) : 1240}}",
                            "hide_desktop_top_nav": "{{_local.form?.hide_desktop_top_nav ? 1 : 0}}",
                            "business_info_enabled": "{{_local.form?.business_info_enabled ? 1 : 0}}",
                            "header_search_icon_mode": "{{_local.form?.header_search_icon_mode === false || _local.form?.header_search_icon_mode === 0 || _local.form?.header_search_icon_mode === '0' || _local.form?.header_search_icon_mode === 'false' ? 0 : 1}}",
                            "header_theme_click_toggle": "{{_local.form?.header_theme_click_toggle === false || _local.form?.header_theme_click_toggle === 0 || _local.form?.header_theme_click_toggle === '0' || _local.form?.header_theme_click_toggle === 'false' ? 0 : 1}}",
                            "footer_link_groups_json": "{{typeof _local.form?.footer_link_groups_json === 'object' && _local.form?.footer_link_groups_json !== null ? JSON.stringify(_local.form.footer_link_groups_json) : String(_local.form?.footer_link_groups_json ?? '')}}",
                            "hide_header_board_slugs_text": "{{Array.isArray(_local.form?.hide_header_board_slugs) ? _local.form.hide_header_board_slugs.join(', ') : String(_local.form?.hide_header_board_slugs_text ?? '')}}",
                            "hide_header_board_slugs": "{{Array.isArray(_local.form?.hide_header_board_slugs) ? _local.form.hide_header_board_slugs : []}}"
                          }
                        },
                        "onSuccess": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "saving": false,
